# Raw market data and derived caches — large, and reproducible from source.
data/*.parquet
data/shards/
data/*.json
# ...EXCEPT the vendored 100-card bundle. README section 3's correctness gate
# (`python -m src.validate_cards`) reproduces the published 11/11 selector table
# from these two files, and that gate is the project's stated precondition for
# trusting anything else. Until now they lived only at a hardcoded path under
# D:\xm\, so a third party could not run the gate at all -- the one check that
# proves the vendored strategy source is unmodified was unreproducible outside
# this machine. They are 1.6 MB total, well inside GitHub's limits.
!data/cards_100/
!data/cards_100/*.json

# Intermediate scan output. The signal CSVs exceed 140 MB each (above GitHub's
# 100 MB per-file hard limit) and are fully regenerated by
#   python -m src.scan_all && python -m src.backtest_lowzone
# The small aggregate reports under reports/ ARE tracked — they hold every
# published number.
outputs/*.parquet
outputs/*_signals*.csv

# ML feature matrices are 176 MB each — over GitHub's 100 MB per-file hard limit,
# so they cannot be pushed. Rebuild with:
#   python -m src.ml.build_matrix --stride 5
# The small metric reports under reports/ ARE tracked, as are the audit evidence
# files under outputs/ml/audit/.
outputs/ml/*.parquet
outputs/ml/**/*.parquet
outputs/ml/*.log
# Per-fold training caches are rebuilt on demand; not evidence.
outputs/ml/crosssec_cache/
# Scratch artifacts from audit scripts ran ~1 GB of regenerable parquet here and
# `git add -A` would have swept it in, so the path is ignored explicitly rather
# than relying on the outputs/ml rule above.
scripts/scratch/_artifacts/
scripts/scratch/**/*.parquet

# Agent scratch directories. These hold throwaway probe output, report
# snapshots and UTF-16 console dumps -- no unique evidence. Kept out of the tree
# so a `git add -A` cannot sweep a 2 MB report snapshot into the repository.
#
# Anchored with a leading slash on purpose: a bare `scratch/` also matches
# `scripts/scratch/`, which holds the durable integrity checkers that ARE meant
# to be tracked.
/.audit_tmp/
/scratch/
*.tmp

# Long commit messages are passed to `git commit -F <file>` and then deleted, but
# `git add -A` in the same command stages the file while it still exists -- it got
# committed once (da81d74, removed in b23d1e6). These are throwaway prose, not
# evidence.
_cmsg_*.txt
_commitmsg.txt
_commit_*.txt

# NOTE: outputs/charts_120d/ IS tracked on purpose. The 120-session K-line
# charts with signal markers are a requested deliverable, not a disposable
# artifact. They are ~86 KB each. Regenerate with `python -m src.make_charts`.
!outputs/ml/audit/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local scratch
*.log

# Scheduled audit output. Regenerated every four hours by
# scripts/scheduled_report_audit.py; see scripts/register_report_audit_task.ps1
# for the Windows Scheduled Task. Kept local so the repository does not gain a
# log file every four hours.
logs/
